# == Book-to-Skills Pipeline Configuration ==
# Copy to .env and fill in your values.

# LLM Provider (openai, anthropic, deepseek, gemini, ollama, openrouter)
B2S_LLM__PROVIDER=openai
B2S_LLM__MODEL_SMALL=gpt-4o-mini
B2S_LLM__MODEL_LARGE=gpt-4o
B2S_LLM__TEMPERATURE=0.3
B2S_LLM__MAX_TOKENS=4096

# API Keys
B2S_LLM__API_KEY=sk-your-key-here
# B2S_LLM__BASE_URL=https://api.openai.com/v1

# Extractor
B2S_EXTRACTOR__USE_OCR_FALLBACK=true
B2S_EXTRACTOR__OCR_LANGUAGES=ara+eng
B2S_EXTRACTOR__PDF_EXTRACTION_MODE=hybrid

# Chunking
B2S_CHUNK__STRATEGY=semantic
B2S_CHUNK__MAX_CHUNK_WORDS=1500
B2S_CHUNK__OVERLAP_WORDS=150

# Cache
B2S_CACHE__ENABLED=true
B2S_CACHE__BACKEND=disk
B2S_CACHE__TTL_HOURS=168

# Queue
B2S_QUEUE__BACKEND=memory
B2S_QUEUE__MAX_CONCURRENT_JOBS=4

# Vector DB
B2S_VECTOR_DB__BACKEND=chroma
B2S_VECTOR_DB__COLLECTION_NAME=book_skills

# Monitoring
B2S_MONITORING__LOG_LEVEL=INFO
B2S_MONITORING__LOG_FORMAT=console
B2S_MONITORING__ENABLE_PROGRESS_BARS=true

# Pipeline
B2S_MAX_WORKERS=4
B2S_INCREMENTAL_MODE=true
B2S_RUN_PARALLEL_STAGES=false
B2S_SKIP_ON_ERROR=false
